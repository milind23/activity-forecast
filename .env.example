# Everything is optional - the app runs with these defaults and no .env file.
# Copy to .env to override.

PORT=3000

# SQLite file (created automatically). Use ":memory:" for a throwaway database.
DATABASE_PATH=data/activity-forecast.sqlite

# Stored forecasts older than this are refreshed lazily on the next request.
FORECAST_TTL_HOURS=3

# How long a "ski area nearby?" answer from OpenStreetMap is trusted.
TERRAIN_CACHE_DAYS=90
SKI_SEARCH_RADIUS_KM=50
# Max time a request waits for a first-time ski-area lookup before answering without it.
TERRAIN_LOOKUP_DEADLINE_MS=15000

HTTP_TIMEOUT_MS=10000

# Upstream endpoints (override for self-hosted instances or tests).
GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
FORECAST_URL=https://api.open-meteo.com/v1/forecast
MARINE_URL=https://marine-api.open-meteo.com/v1/marine
# Comma-separated, tried in order.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
