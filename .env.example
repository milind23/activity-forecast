# Everything is optional - the app runs with these defaults and no .env file.
# Copy to .env to override.

PORT=3000

# HTTP/API protection. Empty CORS list means browser cross-origin requests are disabled;
# server-to-server/Postman requests (which send no Origin header) still work.
CORS_ALLOWED_ORIGINS=
REQUEST_BODY_LIMIT=16kb
# Set to the exact proxy hop count only when the app is actually behind trusted proxies.
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# GraphQL documents are rejected before resolver execution when any budget is exceeded.
GRAPHQL_MAX_DEPTH=8
GRAPHQL_MAX_ALIASES=15
GRAPHQL_MAX_ROOT_FIELDS=4
GRAPHQL_MAX_COMPLEXITY=100

# Local/reviewer mode is public. The secure compose profile forces this to true.
AUTH_REQUIRED=false
# Required when AUTH_REQUIRED=true. Use a secret manager and random keys >=32 characters.
# AUTH_API_KEYS_JSON=[{"subject":"web-client","key":"replace-with-a-random-secret-at-least-32-characters","scopes":["forecast:read"]}]

# SQLite file (created automatically). Use ":memory:" for a throwaway database.
DATABASE_PATH=data/activity-forecast.sqlite

# Stored forecasts older than this are refreshed lazily on the next request.
FORECAST_TTL_HOURS=3

# How long a "ski area nearby?" answer from OpenStreetMap is trusted.
TERRAIN_CACHE_DAYS=90
SKI_SEARCH_RADIUS_KM=50
# Max time a request waits for a first-time public ski-area lookup. The lookup
# continues in the background and is cached; other recommendations should not wait longer.
TERRAIN_LOOKUP_DEADLINE_MS=3000

HTTP_TIMEOUT_MS=10000

# Upstream endpoints (override for self-hosted instances or tests).
GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
FORECAST_URL=https://api.open-meteo.com/v1/forecast
MARINE_URL=https://marine-api.open-meteo.com/v1/marine
# Comma-separated, tried in order.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
